<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/wbg_pink">
    <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🌙" android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_sm" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Lunar cycle" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#E6FFFFFF" android:textSize="11sp" android:gravity="center" />
</LinearLayout>
